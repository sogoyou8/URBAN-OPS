# SQLite only for development. For PostgreSQL, install urban-ops[postgres]
URBAN_OPS_DATABASE_URL=sqlite:///./data/urban_ops.sqlite
URBAN_OPS_BRONZE_DIR=./data/bronze
# When station last_reported is older than 60 min, do not treat as usable.
URBAN_OPS_MAX_LAG_SECONDS=3600
URBAN_OPS_REQUEST_TIMEOUT_SECONDS=20
